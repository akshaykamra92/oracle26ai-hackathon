  "workflows": [
    {
      "id": "tampa-transfer-cascade",
      "name": "Tampa RN transfer cascade",
      "purpose": "Proves source-floor checks, a local backfill chain, eligibility blocks, and an honest remaining headcount gap.",
      "startPath": "/oracle26ai-hackathon/",
      "steps": [
        {
          "action": "goto",
          "value": "https://akshaykamra92.github.io/oracle26ai-hackathon/"
        },
        {
          "action": "waitForText",
          "value": "This opening needs another qualified source."
        },
        {
          "action": "assertText",
          "selector": "#target-count",
          "value": "8"
        },
        {
          "action": "assertText",
          "selector": "#selected-count",
          "value": "7"
        },
        {
          "action": "assertText",
          "selector": "#gap-count",
          "value": "1"
        },
        {
          "action": "assertText",
          "selector": "#backfill-count",
          "value": "1"
        },
        {
          "action": "assertText",
          "selector": "#decisions",
          "value": "Move order: RN-12: Orlando Float Pool \u2192 Orlando West; then RN-02: Orlando West \u2192 New Tampa Rehab."
        },
        {
          "action": "assertText",
          "selector": "#site-rows",
          "value": "7 \u2192 6"
        },
        {
          "action": "assertText",
          "selector": "#decisions",
          "value": "Geography: RN-11 has not opted into a move to Tampa."
        },
        {
          "action": "assertText",
          "selector": "#decisions",
          "value": "License: RN-04's FL license expires before the modeled opening date."
        }
      ],
      "success": {
        "requiredUrlPattern": "",
        "allowedUrlPatterns": [],
        "allText": [
          "7 approved \u00b7 4 blocked",
          "Move order: RN-12: Orlando Float Pool \u2192 Orlando West; then RN-02: Orlando West \u2192 New Tampa Rehab."
        ],
        "anyText": [],
        "visibleSelectors": [
          "#decisions",
          "#site-rows"
        ]
      }
    },
    {
